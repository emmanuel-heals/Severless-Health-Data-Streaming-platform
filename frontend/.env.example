# Health Streaming Platform — frontend environment
# NOTE: Only public identifiers belong here. NEVER put secrets in the frontend bundle (NFR-SEC-08).

# Base URL of the API Gateway REST API
VITE_API_BASE_URL=https://api.example.com

# Amazon Cognito (public identifiers only)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth mode: "cognito" for real Cognito, "mock" for local development without a user pool.
VITE_AUTH_MODE=mock

# Incoming-records feed (OI-10): poll interval in ms
VITE_INCOMING_FEED_POLL_MS=20000

# Feature flags for Open Issues
VITE_FEATURE_DOCUMENT_UPLOAD=false
VITE_FEATURE_DEIDENTIFIED_ANALYST=false
